# Aftertalk configuration. Copy to .env and replace every change-me.
# Environment variables configure infrastructure only; providers, templates,
# taxonomies and languages are set in the UI.

# Image version docker-compose.yml runs.
AFTERTALK_VERSION=0.0.0

# --- Postgres -------------------------------------------------------------
# Password of the bundled Postgres. docker-compose.yml builds DATABASE_URL from it.
POSTGRES_PASSWORD=change-me

# --- Web ------------------------------------------------------------------
# Address people open in the browser, used in reset and invitation links.
PUBLIC_URL=http://localhost:3000
# Signs sessions. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Encrypts provider API keys in the database (32 bytes, base64).
# Generate: openssl rand -base64 32. Losing it makes stored keys unreadable.
SECRETS_KEY=change-me
# Most jobs sent to the engine at once.
ENGINE_MAX_CONCURRENT_JOBS=2
# Optional: comma-separated host names a provider base URL may use
# (lower-case, exact match, no wildcards or ports). Empty means any host.
PROVIDER_HOST_ALLOWLIST=

# Set by docker-compose.yml; change only when running outside it.
# DATABASE_URL=postgres://aftertalk:change-me@postgres:5432/aftertalk
# DATA_DIR=/data
# ENGINE_URL=http://engine:8000

# --- Web and engine -------------------------------------------------------
# Shared secret that signs job requests and result callbacks.
# Generate: openssl rand -base64 32
ENGINE_CALLBACK_SECRET=change-me

# --- Engine ---------------------------------------------------------------
# Set by docker-compose.yml; change only when running outside it.
# WEB_URL=http://web:3000
# Log level: debug, info, warning, error.
LOG_LEVEL=info
